      "id": "basics",
      "title": "確率変数と分布関数",
      "items": [
        {
          "id": "ps02-001",
          "type": "single_choice",
          "prompt": "確率変数 $X$ の説明として正しいものを1つ選びなさい。",
          "answer": "B",
          "explanation": "確率変数は可測な実数値関数であり、この授業では任意の $a\\in\\mathbb{R}$ に対して $\\{X\\le a\\}\\in\\mathcal{F}$ を満たすものとして扱う。",
          "points": 1,
          "tags": [
            "random-variable",
            "definition"
          ],
          "options": [
            {
              "id": "A",
              "text": "実数 $x$ に標本点 $\\omega$ を対応させる関数である。"
            },
            {
              "id": "B",
              "text": "$\\Omega$ 上の実数値関数であり、任意の $a\\in\\mathbb{R}$ に対して $\\{X\\le a\\}\\in\\mathcal{F}$ を満たす。"
            },
            {
              "id": "C",
              "text": "実数上の確率測度そのものである。"
            },
            {
              "id": "D",
              "text": "$\\Omega$ から $\\mathbb{R}$ への関数なら、条件なしに確率変数と呼ぶ。"
            }
          ]
        },
        {
          "id": "ps02-002",
          "type": "single_choice",
          "prompt": "確率変数 $X$ の分布関数 $F_X$ について、一般には成り立つとは限らないものを1つ選びなさい。",
          "answer": "D",
          "explanation": "分布関数は $0$ 以上 $1$ 以下、単調非減少、右連続である。一方、一般の分布関数がすべての点で微分可能とは限らない。",
          "points": 1,
          "tags": [
            "cdf",
            "properties"
          ],
          "options": [
            {
              "id": "A",
              "text": "$0\\le F_X(x)\\le 1$"
            },
            {
              "id": "B",
              "text": "$F_X$ は単調非減少である。"
            },
            {
              "id": "C",
              "text": "$F_X$ は右連続である。"
            },
            {
              "id": "D",
              "text": "$F_X$ はすべての点で微分可能である。"
            }
          ]
        }
      ]
    },
